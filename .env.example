# Subsoccer Environment Configuration Template
# Copy to .env for local development

# ─── NETIO PowerBOX 3PF / 4KF Smart Relay Configuration ───
# In production, use private tunnel / reverse proxy URL (e.g. https://relay-tripla.subsoccer.internal)
NETIO_BASE_URL=http://192.168.1.150
NETIO_USERNAME=admin
NETIO_PASSWORD=your_netio_password_here

# Legacy aliases (supported for backwards compatibility)
# NETIO_ENDPOINT=http://192.168.1.150
# NETIO_USER=admin
# NETIO_PASS=your_netio_password_here

# ─── Administration & Security ───
# Required for emergency stops, relay overrides, and admin operations.
# In production, this MUST be set. There is NO hardcoded default.
ADMIN_TOKEN=your_strong_admin_secret_here

# ─── Pilot Constraints & Environment ───
# 'production', 'staging', or 'test'. In production, mock DB/hardware is blocked.
ARCADE_ENV=production
# Set to 'true' to explicitly approve free play without payment or admin token:
ARCADE_FREE_PLAY_APPROVED=false
# Restrict pilot fleet to a single designated table ID:
PILOT_TABLE_ID=demo-pulse-01

# ─── Supabase Database Configuration ───
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Backend functions require service_role key to manage table locking and audit events:
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ─── Stripe Payment Configuration ───
# STRIPE_SECRET_KEY=sk_test_your_key_here
# STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
